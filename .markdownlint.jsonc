{
  // Repo-wide markdownlint config. CI runs this on every pull request, so a
  // rule turned off here is a rule nothing enforces.
  //
  // MD013 (line-length): prose in these repos is authored one paragraph per
  // line. Sentences flow unwrapped and the renderer handles soft-wrapping. An
  // 80-column hard-wrap rule would flag essentially every paragraph and force
  // a reflow that fights the authoring convention and bloats every diff.
  // Readability here is the renderer's job, not the source's.
  //
  // MD024 (no-duplicate-heading): siblings_only allows a repeated heading
  // under different parents, such as a per-chapter section in the build plan
  // repeating a heading another chapter already uses, while still catching two
  // same-named headings inside one section. docs/replication-log.md relies on
  // it: Entry 2 repeats Entry 1's three table headings, which is the shape the
  // file's own rule for a second entry asks for.
  //
  // MD033 (no-inline-html): <details> and <summary> render on GitHub and are
  // how a document hides an answer until the reader has committed to a
  // prediction. Every other inline HTML element stays flagged.
  "default": true,
  "MD013": false,
  "MD024": { "siblings_only": true },
  "MD033": { "allowed_elements": ["details", "summary"] }
}
